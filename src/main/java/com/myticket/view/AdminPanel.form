<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.myticket.view.AdminPanel">
  <grid id="27dc6" binding="rootPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="12">
    <margin top="16" left="20" bottom="18" right="20"/>
    <constraints>
      <xy x="20" y="20" width="840" height="540"/>
    </constraints>
    <properties>
      <background color="-525828"/>
    </properties>
    <border type="none"/>
    <children>
      <!-- HEADER BAR -->
      <grid id="1001" binding="headerPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="0">
        <margin top="12" left="18" bottom="12" right="18"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-15792342"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="1002" class="javax.swing.JLabel" binding="headerTitleLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="SansSerif" size="20" style="1"/>
              <foreground color="-1"/>
              <text value="⚙  Admin Control Center"/>
            </properties>
          </component>
          <component id="1003" class="javax.swing.JLabel" binding="headerSubtitleLabel">

          <foreground color="-15792342"/>
        </properties>
        <border type="none"/>
        <children>
          <!-- TAB 1: MOVIE MANAGEMENT -->
          <grid id="3001" binding="movieTabPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="16" vgap="0">
